QUEUE_SYSTEM LOCAL
QUEUE_OPTION LOCAL MAX_RUNNING 4

RANDOM_SEED 11223344

RUNPATH spe1_out/realization-<IENS>/iter-<ITER>

NUM_REALIZATIONS 4

ECLBASE INACTIVE_CELL_WITH_WELL_CONNECTION

OBS_CONFIG obs.txt

GEN_KW FIELD_PROPERTIES field_properties_priors

FORWARD_MODEL TEMPLATE_RENDER( \
    <INPUT_FILES>=parameters.json, \
    <TEMPLATE_FILE>=<CONFIG_PATH>/INACTIVE_CELL_WITH_WELL_CONNECTION.DATA.jinja2, \
    <OUTPUT_FILE>=INACTIVE_CELL_WITH_WELL_CONNECTION.DATA \
)

FORWARD_MODEL FLOW

RFT WELL:OP1 DATE:2000-01-01 PROPERTIES:PRESSURE,SWAT,SGAS

HOOK_WORKFLOW_JOB export_rft_data EXPORT_RFT POST_SIMULATION
